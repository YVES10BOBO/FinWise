<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
      Camera and photo permissions removed along with the profile-picture
      feature. Requesting fewer permissions means a simpler Play review and
      a clearer Data Safety declaration — the app now collects no photos.
      The tools:node="remove" entries stay so any transitive dependency
      cannot silently re-add broad photo access.
    -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO"
        tools:node="remove" />

    <!--
      SMS permissions for auto-detecting Mobile Money transactions.
      This qualifies under Google Play's "SMS-based money management"
      permitted-use exception (apps that track and manage budget), so it
      does NOT require the app to be the default SMS handler. See:
      https://support.google.com/googleplay/android-developer/answer/10208820
      Only READ_SMS/RECEIVE_SMS are requested — never SEND_SMS or WRITE_SMS,
      since this app only reads transaction notifications, never sends texts.
    -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!--
      Requesting SMS permissions makes Android imply that the device MUST have
      telephony hardware, which silently removed ~3,900 devices from Play
      distribution — every Wi-Fi-only tablet, Chromebook and TV.
      FinWise works perfectly well without a SIM (manual entry, goals, charts,
      sync), so telephony is explicitly optional. SMS auto-detection simply
      stays inactive on devices that can't receive messages.
    -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!--
      Foreground service — keeps FinWise's process alive (with a visible,
      required notification) while SMS auto-detect is on, so Android is
      much less likely to kill the app before it can react to an incoming
      Mobile Money SMS. "dataSync" fits this use case (syncing/monitoring
      financial transaction data on-device).
    -->
    <!--
      Biometric unlock for the in-app PIN lock. Biometric data never reaches
      the app: Android verifies the user in secure hardware and returns only
      a success/failure result.
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:label="FinWise Tracker"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Required by the `telephony` package to receive incoming SMS,
             even while the app is backgrounded. Only fires if the user has
             granted RECEIVE_SMS (requested at runtime, off by default). -->
        <receiver
            android:name="com.shounakmulay.telephony.sms.IncomingSmsReceiver"
            android:permission="android.permission.BROADCAST_SMS"
            android:exported="true">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Warning: Do not change this service name — required as-is by
             the flutter_foreground_task plugin. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
