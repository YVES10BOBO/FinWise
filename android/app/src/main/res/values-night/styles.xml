<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark-mode variant. Both windows deliberately use the SAME brand
         colour as light mode: the launch screen is FinWise's identity, and
         following the system theme here is what made the splash render
         black on phones with dark mode enabled. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/finwise_splash</item>
    </style>
</resources>
