rules_version = '2';

// Firebase Storage rules for FinWise — profile pictures only.
//
// Publish in the Firebase Console: Storage → Rules → Paste → Publish.
//
// Without these, default test-mode rules would let anyone upload arbitrary
// files to your bucket (which you pay for) and read other users' photos.

service firebase.storage {
  match /b/{bucket}/o {

    // Each user may only touch files under their own uid folder.
    match /profile_pictures/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow write: if request.auth != null
                   && request.auth.uid == userId
                   // Images only, max 5 MB — stops the bucket being used
                   // as free file hosting.
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
